            TweenService:Create(cl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
            TweenService:Create(il, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
            TweenService:Create(acc, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
            fo:Play() fo.Completed:Wait() notif:Destroy()
