-- Get currently active ball object (Server TPS ball or Client ball)
local function getActiveBall()
    local tpsSystem = Workspace:FindFirstChild("TPSSystem")
    local tpsBall = tpsSystem and tpsSystem:FindFirstChild("TPS")
    if tpsBall and tpsBall:IsA("BasePart") then
        return tpsBall
    end
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and model.Name:match("^CLIENT_BALL_%d+$") then
            local clientBall = model:FindFirstChild("Ball.001") or findFirstPart(model)
            if clientBall and clientBall:IsA("BasePart") then
                return clientBall
            end
        end
    end
    return nil
end

-- Monitor and update Ball ESP on Heartbeat
RunService.Heartbeat:Connect(function()
    if not ballEspEnabled then
        for part in pairs(ballHighlights) do
            removeBallHighlight(part)
        end
        return
    end

    -- Find main TPS ball
    local tpsSystem = Workspace:FindFirstChild("TPSSystem")
    local tpsBall = tpsSystem and tpsSystem:FindFirstChild("TPS")
    if tpsBall and tpsBall:IsA("BasePart") then
        applyBallHighlight(tpsBall)
    end

    -- Find client balls
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and model.Name:match("^CLIENT_BALL_%d+$") then
            local basePart = model:FindFirstChild("Ball.001") or findFirstPart(model)
            if basePart and basePart:IsA("BasePart") then
                applyBallHighlight(basePart)
            end
        end
    end

    -- Clean up highlights for balls that no longer exist
    for part in pairs(ballHighlights) do
        if not part or not part.Parent or not part:IsDescendantOf(Workspace) then
            removeBallHighlight(part)
        end
    end
end)

-- Ball Prediction Variables
local ballPredictEnabled = false
local verticalLineBeam = nil
local verticalLineTarget = nil
local verticalLineAttachment = nil

-- Dedicated Folder for Bendy Path segments
local segmentFolder = Workspace:FindFirstChild("AERO_Segments")
if not segmentFolder then
    segmentFolder = Instance.new("Folder")
    segmentFolder.Name = "AERO_Segments"
    segmentFolder.Parent = Workspace
end

local segmentPool = {}
local landingRing = nil

local function clearSegments()
    for _, part in ipairs(segmentPool) do
        part.Transparency = 1
    end
    if landingRing then
        landingRing.Transparency = 1
    end
end

local function drawCurve(points)
    -- Reset visibility of all pooled parts
    for _, part in ipairs(segmentPool) do
        part.Transparency = 1
    end

    for i = 1, #points - 1 do
        local pA = points[i]
        local pB = points[i+1]
        local distance = (pB - pA).Magnitude
        
        local part = segmentPool[i]
        if not part or not part.Parent then
            part = Instance.new("Part")
            part.Name = "CurveSegment"
            part.Anchored = true
            part.CanCollide = false
            part.Material = Enum.Material.Neon
            part.Color = Color3.fromRGB(0, 255, 0) -- Neon green path
            part.Transparency = 0.4
            part.Shape = Enum.PartType.Cylinder
            part.Parent = segmentFolder
            segmentPool[i] = part
        end
        
        part.Size = Vector3.new(0.12, 0.12, distance)
        -- Align cap with cap alignment rotated 90 degrees around Y-axis
        part.CFrame = CFrame.lookAt(pA + (pB - pA)/2, pB) * CFrame.Angles(0, math.rad(90), 0)
        part.Transparency = 0.4
    end
end

local function drawLandingRing(position)
    if not landingRing or not landingRing.Parent then
        landingRing = Instance.new("Part")
        landingRing.Name = "LandingRing"
        landingRing.Shape = Enum.PartType.Cylinder
        landingRing.Size = Vector3.new(0.05, 3.5, 3.5)
        landingRing.Anchored = true
        landingRing.CanCollide = false
        landingRing.Material = Enum.Material.Neon
        landingRing.Color = Color3.fromRGB(0, 255, 255) -- Cyan landing zone circle
        landingRing.Transparency = 0.6
        landingRing.Parent = segmentFolder
    end
    -- Lie cylinder flat on floor (caps facing upwards)
    landingRing.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    landingRing.Transparency = 0.6
end

local function removePredictLines()
    if verticalLineBeam then verticalLineBeam:Destroy() verticalLineBeam = nil end
    if verticalLineTarget then verticalLineTarget:Destroy() verticalLineTarget = nil end
    if verticalLineAttachment then verticalLineAttachment:Destroy() verticalLineAttachment = nil end
    
    clearSegments()
    if landingRing then
        landingRing:Destroy()
        landingRing = nil
    end
end

local function updatePredictLines(ball)
    if not ballPredictEnabled then
        removePredictLines()
        return
    end

    -- Setup Vertical shadow line straight down
    if not verticalLineAttachment or verticalLineAttachment.Parent ~= ball then
        removePredictLines()
        verticalLineAttachment = Instance.new("Attachment", ball)
        
        verticalLineTarget = Instance.new("Part")
        verticalLineTarget.Name = "VerticalLineTarget"
        verticalLineTarget.Anchored = true
        verticalLineTarget.CanCollide = false
        verticalLineTarget.Transparency = 1
        verticalLineTarget.Size = Vector3.new(0.1, 0.1, 0.1)
        verticalLineTarget.Parent = Workspace
        
        local targetAtt = Instance.new("Attachment", verticalLineTarget)
        
        verticalLineBeam = Instance.new("Beam")
        verticalLineBeam.Attachment0 = verticalLineAttachment
        verticalLineBeam.Attachment1 = targetAtt
        verticalLineBeam.Width0 = 0.15
        verticalLineBeam.Width1 = 0.15
        verticalLineBeam.FaceCamera = true
        verticalLineBeam.LightEmission = 1
        verticalLineBeam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255)) -- Cyan indicator straight down
        verticalLineBeam.Parent = ball
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local excludeList = {ball, espFolder, segmentFolder}
    if LocalPlayer.Character then
        table.insert(excludeList, LocalPlayer.Character)
    end
    raycastParams.FilterDescendantsInstances = excludeList

    -- 1. Draw Vertical Shadow Line
    local vertResult = Workspace:Raycast(ball.Position, Vector3.new(0, -300, 0), raycastParams)
    if vertResult then
        verticalLineTarget.Position = vertResult.Position
        verticalLineBeam.Enabled = true
    else
        verticalLineBeam.Enabled = false
    end

    -- 2. Simulate Parabolic Trajectory Curve (Bendy Line)
    local velocity = ball.AssemblyLinearVelocity or ball.Velocity
    local gravityForce = Vector3.new(0, -Workspace.Gravity, 0)
    
    local dt = 0.05
    local maxSteps = 45
    
    local points = {ball.Position}
    local currentPos = ball.Position
    local currentVel = velocity
    local hitFloor = false
    local floorPos = nil

    for i = 1, maxSteps do
        -- Parabolic projectile step formula
        local nextPos = currentPos + currentVel * dt + 0.5 * gravityForce * dt * dt
        currentVel = currentVel + gravityForce * dt
        
        local raycastResult = Workspace:Raycast(currentPos, nextPos - currentPos, raycastParams)
        if raycastResult then
            table.insert(points, raycastResult.Position)
            hitFloor = true
            floorPos = raycastResult.Position
            break
        else
            table.insert(points, nextPos)
            currentPos = nextPos
        end
    end

    -- Draw the bendy cylinders tracing the points
    drawCurve(points)

    -- Place the landing zone disk
    if hitFloor and floorPos then
        drawLandingRing(floorPos)
    else
        if landingRing then
            landingRing.Transparency = 1
        end
    end
end

-- Update predict lines on Heartbeat
RunService.Heartbeat:Connect(function()
    if ballPredictEnabled then
        local activeBall = getActiveBall()
        if activeBall then
            updatePredictLines(activeBall)
        else
            removePredictLines()
        end
    else
        removePredictLines()
    end
end)

-- Remove line for a player
local function removeLine(player)
    local data = lines[player]
    if data then
        if data.beam then data.beam:Destroy() end
        if data.target and data.target.Parent then data.target:Destroy() end
        if data.attachment and data.attachment.Parent then data.attachment:Destroy() end
        lines[player] = nil
    end
end

-- Update line for a player
local function updateLine(player, index)
    if not linesEnabled then
        removeLine(player)
        return
    end

    local character = player.Character
    if not character or not character:FindFirstChild("Head") or not character:FindFirstChild("HumanoidRootPart") then
        removeLine(player)
        return
    end

    local head = character.Head
    local rootPart = character.HumanoidRootPart

    if not lines[player] then
        local attachment = Instance.new("Attachment", head)
        local target = Instance.new("Part")
        target.Anchored = true
        target.CanCollide = false
        target.Transparency = 1
        target.Size = Vector3.new(0.1, 0.1, 0.1)
        target.Parent = Workspace

        local targetAttachment = Instance.new("Attachment", target)
        local beam = Instance.new("Beam")
        beam.Attachment0 = attachment
        beam.Attachment1 = targetAttachment
        beam.Width0 = 0.25
        beam.Width1 = 0.25
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.Transparency = NumberSequence.new(0.3)
        beam.Color = ColorSequence.new(lineColors[(index - 1) % #lineColors + 1])
        beam.Parent = head

        lines[player] = { beam = beam, target = target, attachment = attachment }
    end

    local data = lines[player]
    data.target.Position = head.Position + rootPart.CFrame.LookVector * lineDistance
end

-- Update lines for all players
RunService.RenderStepped:Connect(function()
    if linesEnabled then
        for index, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and isEnemy(player) then
                updateLine(player, index)
            else
                removeLine(player)
            end
        end
    else
        for player in pairs(lines) do
            removeLine(player)
        end
    end
end)

