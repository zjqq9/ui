function Library:Notify(Data)
    Data = Data or {}
    local title = Data.Title or "Notification"
    local content = Data.Content or Data.Description or ""
    local duration = Data.Time or Data.Duration or 3
    
    local lc = string.lower(content)
    local icon = "ℹ️"
    local accentColor = Color3.fromRGB(50, 140, 255)
    if string.find(lc, "deactivated") or string.find(lc, "disabled") or string.find(lc, "reset") or string.find(lc, "failed") or string.find(lc, "not found") or string.find(lc, "error") then
        icon = "❌"
        accentColor = Color3.fromRGB(220, 70, 70)
    elseif string.find(lc, "activated") or string.find(lc, "enabled") or string.find(lc, "applied") or string.find(lc, "set to") or string.find(lc, "teleported") then
        icon = "✅"
        accentColor = Color3.fromRGB(80, 200, 120)
    end
    local notif = Instance.new("Frame")
    notif.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
    notif.Size = UDim2.new(1, 0, 0, 52)
    notif.BorderSizePixel = 0
    notif.ZIndex = 100000
    notif.ClipsDescendants = true
    notif.Parent = NotifHolder
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)
    local acc = Instance.new("Frame", notif)
    acc.BackgroundColor3 = accentColor
    acc.Size = UDim2.new(0, 3, 1, 0)
    acc.BorderSizePixel = 0
    acc.ZIndex = 100001
    local il = Instance.new("TextLabel", notif)
    il.Text = icon il.Font = Enum.Font.GothamBold il.TextSize = 18
    il.BackgroundTransparency = 1 il.Size = UDim2.new(0, 30, 1, 0)
    il.Position = UDim2.new(0, 10, 0, 0) il.ZIndex = 100001
    local tl = Instance.new("TextLabel", notif)
    tl.Text = title tl.Font = Enum.Font.GothamBold tl.TextSize = 13
    tl.TextColor3 = Color3.fromRGB(230, 230, 245) tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.BackgroundTransparency = 1 tl.Size = UDim2.new(1, -50, 0, 20)
    tl.Position = UDim2.new(0, 42, 0, 6) tl.ZIndex = 100001
    local cl = Instance.new("TextLabel", notif)
    cl.Text = content cl.Font = Enum.Font.Gotham cl.TextSize = 12
    cl.TextColor3 = Color3.fromRGB(160, 162, 180) cl.TextXAlignment = Enum.TextXAlignment.Left
    cl.TextTruncate = Enum.TextTruncate.AtEnd cl.BackgroundTransparency = 1
    cl.Size = UDim2.new(1, -50, 0, 16) cl.Position = UDim2.new(0, 42, 0, 28) cl.ZIndex = 100001
    local prog = Instance.new("Frame", notif)
    prog.BackgroundColor3 = accentColor prog.BackgroundTransparency = 0.5
    prog.AnchorPoint = Vector2.new(0, 1) prog.Position = UDim2.new(0, 0, 1, 0)
    prog.Size = UDim2.new(1, 0, 0, 2) prog.BorderSizePixel = 0 prog.ZIndex = 100001
    notif.BackgroundTransparency = 1 tl.TextTransparency = 1 cl.TextTransparency = 1
    il.TextTransparency = 1 acc.BackgroundTransparency = 1
    
    local TweenService = game:GetService("TweenService")
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {BackgroundTransparency = 0.02}):Play()
    TweenService:Create(tl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(cl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(il, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(acc, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
    TweenService:Create(prog, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()
    task.delay(duration, function()
        pcall(function()
            local fo = TweenService:Create(notif, TweenInfo.new(0.4), {BackgroundTransparency = 1})
