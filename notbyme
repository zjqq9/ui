local savedElements = {}

function Library:Window(windowConfig)
    local WindowCompat = {}
    
    local windowObj = RawLibrary:CreateWindow(windowConfig.Name or "AERO")
    
    RawLibrary.OnMinimize = function()
        local UserInputService = game:GetService("UserInputService")
        if not UserInputService.TouchEnabled then
            Notify({
                Title = "UI Minimized",
                Content = "Press Right Shift to reopen.",
                Time = 3
            })
        end
    end
    
    local UI = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("KairoUI")
    Library.Holder.Instance = UI
    
    WindowCompat.IsOpen = true
    function WindowCompat:SetOpen(bool)
        if WindowCompat.IsOpen ~= bool then
            local main = UI:FindFirstChild("Main")
            if main then main.Visible = bool end
            WindowCompat.IsOpen = bool
        end
    end
    
    function WindowCompat:Page(pageConfig)
        local PageCompat = {}
        
        local tabObj = windowObj:CreateTab(pageConfig.Name, pageConfig.Icon)
        
        function PageCompat:SubPage(subPageConfig)
            local SubPageCompat = {}
            
            local subTabCanvas = tabObj:CreateSubTab(subPageConfig.Name)
            
            function SubPageCompat:Section(sectionConfig)
                local SectionCompat = {}
                
                function SectionCompat:Label(labelConfig)
                    local labelObj = windowObj:CreateLabel(labelConfig.Name, subTabCanvas)
                    local LabelCompat = {}
                    function LabelCompat:Keybind(keybindConfig)
                        local UserInputService = game:GetService("UserInputService")
                        local currentKey = keybindConfig.Default
                        UserInputService.InputBegan:Connect(function(input, gp)
                            if gp then return end
                            if input.KeyCode == currentKey then
                                keybindConfig.Callback()
                            end
                        end)
                        
                        if labelObj and labelObj:FindFirstChild("Title") then
                            labelObj.Title.Text = labelConfig.Name .. " - Hotkey: " .. tostring(currentKey.Name)
                        end
                    end
                    return LabelCompat
                end
                
                function SectionCompat:Toggle(toggleConfig)
                    local obj = windowObj:CreateToggle(toggleConfig.Name, subTabCanvas, function(state)
                        toggleConfig.Callback(state)
                    end)
                    savedElements[toggleConfig.Name] = {type = "Toggle", instance = obj}
                    return obj
                end
                
                function SectionCompat:Slider(sliderConfig)
                    local obj = windowObj:CreateSlider(sliderConfig.Name, subTabCanvas, sliderConfig.Min, sliderConfig.Max, sliderConfig.Default, function(val)
                        sliderConfig.Callback(val)
                    end)
                    savedElements[sliderConfig.Name] = {type = "Slider", instance = obj}
                    return obj
                end
                
                function SectionCompat:Textbox(textboxConfig)
                    local obj = windowObj:CreateInput(textboxConfig.Name, subTabCanvas, textboxConfig.Placeholder or "Enter text...", function(val)
                        textboxConfig.Callback(val)
                    end)
                    savedElements[textboxConfig.Name] = {type = "Textbox", instance = obj}
                    return obj
                end
                SectionCompat.TextBox = SectionCompat.Textbox
 
                function SectionCompat:Dropdown(dropdownConfig)
                    local obj = windowObj:CreateDropdown(dropdownConfig.Name, subTabCanvas, dropdownConfig.Options or {}, function(val)
                        dropdownConfig.Callback(val)
                    end)
                    savedElements[dropdownConfig.Name] = {type = "Dropdown", instance = obj}
                    return obj
                end
                
                function SectionCompat:Button(buttonConfig)
                    return windowObj:CreateButton(buttonConfig.Name, subTabCanvas, function()
                        buttonConfig.Callback()
                    end)
                end
                
                return SectionCompat
            end
            
            return SubPageCompat
        end
        
        return PageCompat
    end
    
    return WindowCompat
end

